Content-Type: application/json

{
  "titulo": "El equipo no tiene conexión a Internet",
  "descripcion": "El usuario reporta que su equipo no puede conectarse a la red.",
  "prioridad": "Alta",
  "usuarioId": 3,
  "categoriaId": 3
}


